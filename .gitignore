# Data files (large files, should be downloaded separately)
# data/* en vez de data/ para poder whitelistear archivos chicos derivados
data/*
!data/filters/
# dm15(B) por template Ia (config derivada de precompute_dm15_Ia.py)
!data/ibc_subtypes.csv
!data/ii_subtypes.csv
# tasas publicadas de SUDARE I (Tabla 7 de arXiv:1509.04496v4), Nivel 1
!data/sudare_I_table5.csv
# m50 por epoca de SUDARE I (Tabla 2 de arXiv:1509.04496v4), cruzada con obslog_I
!data/sudare_I_m50.csv
!data/dm15_Ia.json
# md5 de las 78 congeladas copiadas a data/<clase>_v78 (2026-10-02)
!data/templates_v78_md5.csv
# exclusiones manuales de SNe reales revisadas por Mauricio (2026-10-03)
!data/excluir_manual_reales.csv
# diffmaglim de las alertas ALeRCE del holdout ZTF val, entrada de pipeline78/calib_ruido.py (2026-10-04)
!data/ruido_alerce_val.csv
# alertas ALeRCE (diffmaglim) de los 1000 campos de la proyeccion, entrada de pipeline78/obslog_alerce.py (2026-10-04)
!data/obslog_alerce_cache.csv.gz
# alertas ALeRCE (isdiffpos) de las SNe reales fuera del cache de val, entrada de pipeline78/real_to_parquet.py (2026-10-04)
!data/reales_alerce_cache.csv
# alertas ALeRCE (magpsf, sigmapsf, diffmaglim, isdiffpos) de las viejas val_viejo, entrada de pipeline78/calib_obs.py (2026-10-04)
!data/ruido_alerce_viejas.csv
!data/alertas_viejas.csv
!data/api_completar_det.csv
!data/api_completar_nodet.csv

